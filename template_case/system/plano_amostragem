FoamFile
{
    version     2.0;
    format      ascii;
    class       functionObject;
    location    "system";
    object      plano_amostragem;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            surfaceFieldValue;
libs            ("fieldFunctionObjects");
writeControl    writeTime;
log             true;
operation       areaAverage;
fields          (p);
regionType      sampledSurface;
sampledSurfaceDict
{
    type            plane;
    planeType       pointAndNormal;
    pointAndNormalDict
    {
        point   (0 0 0.750000);
        normal  (0 0 1);
    }
}
