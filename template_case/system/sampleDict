FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            surfaces;
surfaceFormat   raw;
fields          (p);

surfaces
(
    plane_start
    {
        type            plane;
        planeType       pointAndNormal;
        pointAndNormalDict
        {
            point   (0 0 1.4000);
            normal  (0 0 1);
        }
    }
    plane_end
    {
        type            plane;
        planeType       pointAndNormal;
        pointAndNormalDict
        {
            point   (0 0 1.8000);
            normal  (0 0 1);
        }
    }
);

